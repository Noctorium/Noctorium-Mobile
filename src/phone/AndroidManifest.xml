<?xml version="1.0" encoding="utf-8"?>
<!--
  Noctorium for phones, with Android Auto. It also keeps a card on a TV's home screen, opening the phone's screens with
  the remote: a TV that updated itself from 0.37 or older, when one APK was everything, lands on this build, and
  must still be able to open Noctorium, whose updater then moves it to Noctorium for TV.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application>
        <!--
          Player mode: Noctorium as the phone's home screen (Noctorium-Mp3-Like-Player-Android-Launcher-). Switched off
          here, so no phone is asked to choose Noctorium as its home screen; Settings › On this phone › Player mode
          switches it on, after warning that it is for a spare phone.
        -->
        <activity
            android:name=".LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Noctorium Player"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:theme="@style/Theme.Noctorium">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
