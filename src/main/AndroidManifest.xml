<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Reading the services, and nothing else. Noctorium asks for no storage, no contacts, no location.
        The camera, which the QR scanner library declares, is asked for only when scanning the code a
        computer shows to take this phone's YouTube Music sign-in, and used for nothing else.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Noctorium Connect listens for the listener other devices announcing themselves on the local
        network. Without this, the wifi chip filters those broadcasts out before the application ever
        sees them and the device list is silently always empty.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        Noctorium is sideloaded, so nothing else updates it. This lets it hand a downloaded APK to
        Android's own package installer — which shows its own screen and asks again, and the first
        time also sends the listener to a settings page to allow it at all. Noctorium installs nothing
        itself; it only asks the system to.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Music has to keep playing when the screen goes off, which on Android means a foreground service.
      MEDIA_PLAYBACK is the type that grants it, and the notification permission is what lets the service
      show the control it is required to show.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Lets Noctorium ask, through Android's own dialog which the listener answers, to be left out of
      battery optimisation. A foreground service is not always enough: Xiaomi's and some others' power
      managers stop background apps when the screen locks regardless, music included.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      For "Keep Noctorium alive", which is off unless the listener turns it on. Kept alive with nothing to play,
      Noctorium shows a quiet notification from a foreground service of its own, and SPECIAL_USE is the type for
      that: the reason, said under the services below, is not one any of Android's other types names.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Also for keep-alive: lets Noctorium start again once the phone has started up, so a restart does not end it.
      With keep-alive off, the receiver it wakes does nothing at all.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The backup rules leave the history of what was played out of Android's backups, to Google Drive and to a new
      phone alike: it is kept on this phone and nowhere else. Everything else is backed up as it always was.
    -->
    <application
        android:name=".NoctoriumApplication"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Noctorium"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Noctorium.Starting"
            android:exported="true"
            android:label="${appLabel}"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share, then Noctorium, from YouTube, YouTube Music or SoundCloud: what they share is text with
              the link in it, and that plays. Text only, never a VIEW filter for their addresses, which would
              put Noctorium between the listener and every YouTube link they tap anywhere.
            -->
            <intent-filter android:label="@string/share_to_play">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Lets the share sheet read a file Noctorium saved, and nothing else — see file_paths.xml. Exported
          false with per-URI grants is the shape that keeps the cookie jars beside it unreachable.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Media3's session service, which is what makes the lock screen controls, the notification and the
          Bluetooth buttons work. Without it the player stops the moment the activity goes away.

          mediaPlayback while a song is loaded. specialUse as well, for keep-alive only: when the song goes with
          keep-alive on, this shows keep-alive's quiet notification in its place rather than leave the foreground,
          since coming back into it from the background is what Android does not always allow.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep alive, chosen by the listener: keeps the music player running and reachable by their other devices over the local network between songs, on phones whose power managers close background apps." />
        </service>

        <!--
          Keep-alive's own foreground service, for while nothing is loaded to play: it does nothing but hold
          Noctorium up, with its quiet notification. Not exported; only Noctorium starts it.
        -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep alive, chosen by the listener: keeps the music player running and reachable by their other devices over the local network between songs, on phones whose power managers close background apps." />
        </service>

        <!--
          Brings keep-alive back after the phone starts up, after Noctorium is updated, and when its watchdog alarm
          finds it gone; and the quiet notification's Turn off. Not exported: the first two come from Android itself,
          the others from Noctorium.
        -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The code scanner, turned the way the phone is held rather than locked sideways. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>
</manifest>
