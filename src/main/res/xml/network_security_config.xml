<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything Noctorium fetches is https, and this keeps it that way.

  The one exception is 127.0.0.1, which is where Spotify's and Tidal's sign-in replies are caught. That address never
  leaves the device — the browser and the receiver are the same phone — and Spotify will not accept an
  https redirect to a loopback address anyway.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
